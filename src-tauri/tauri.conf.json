{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Round Robin Tournament Manager",
  "version": "0.1.0",
  "identifier": "space.andymac.roundrobin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:tauri",
    "beforeBuildCommand": "pnpm build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Round Robin Tournament Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 768,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Andy Mac",
    "category": "Sports",
    "shortDescription": "Local round-robin football tournament manager",
    "longDescription": "Create leagues and seasons, generate fixtures, record results, and calculate standings in a private local desktop application.",
    "copyright": "Copyright © 2026 Andy Mac",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
